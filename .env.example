OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 보고서 품질 평가 LLM Judge (생성 모델과 분리)
JUDGE_MODEL=gpt-4.1
# 보고서 생성 출력 토큰 한도 (REFERENCE 잘림 방지)
REPORT_MAX_TOKENS=16384

# Local FAISS index
FAISS_INDEX_DIR=artifacts/faiss
PREPROCESSED_CHUNKS=database/chunks.jsonl
DOCUMENT_MANIFEST=database/manifest.json
# needs_review=true인 청크는 기본적으로 원본 확인 전까지 검색에서 제외합니다.
INCLUDE_REVIEW_CHUNKS=false
EMBEDDING_MODEL=BAAI/bge-m3
# Optional: pin a model revision; the resolved revision is saved in manifest.json.
# EMBEDDING_REVISION=
# Optional: assert the model output dimension (BGE-M3 dense: 1024).
# EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8

RETRIEVAL_TOP_K=5

# Optional: OpenAI-compatible endpoint, local embedding device, Korean TTF font
# OPENAI_BASE_URL=
# EMBEDDING_DEVICE=cpu
# PDF_FONT=/absolute/path/to/korean-font.ttf
# LangSmith (Monitoring)
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# Optional: workspace for an organization-scoped API key
# LANGSMITH_WORKSPACE_ID=
